# Copy to .env; docker compose reads it automatically.

# Board address. 0.0.0.0 opens it to the network; 127.0.0.1 keeps it on this machine.
APP_ADDR=0.0.0.0
APP_PORT=8080

# Grafana, Jaeger, Prometheus, RabbitMQ UI and Postgres have no real passwords.
TOOLS_ADDR=127.0.0.1

# Change the token whenever the board is reachable from outside.
ADMIN_TOKEN=lecturer
# With false, only the host console may reset rounds and start countdowns.
PUBLIC_RESET=true
